# e-Tekisi production settings for docker-compose.prod.yml.
# Copy to .env.prod (gitignored), fill in every value, and restrict it:
#   chmod 600 .env.prod
# Keep a copy of the secrets in your password manager / secrets vault:
# losing DATA_ENCRYPTION_KEY makes stored bank details unreadable.

# Public hostname. Its DNS A/AAAA record must point at this server, and ports
# 80 and 443 must be open, for Caddy to get a TLS certificate.
DOMAIN=tekisi.example.co.za
# Let's Encrypt account / expiry notices.
ACME_EMAIL=ops@example.co.za

# Database
DB_NAME=etekisi
DB_USER=etekisi_app
DB_PASSWORD=replace-with-a-long-random-password

# Min 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRY_MINUTES=60

# Encrypts payout bank details. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# First operator account (created once on first start). Password 12+ chars.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Safety paging. CRITICAL alerts (panic button) are POSTed here so on-call
# is woken up. Leave empty only for a dry run: alerts then reach just the
# log and /ops.
#   generic   - JSON with a "text" field: Slack/Teams incoming webhook, an SMS
#               gateway, Opsgenie/Grafana OnCall HTTP integration. The secret,
#               if set, is sent as the Authorization header (e.g. "Bearer xyz").
#   pagerduty - https://events.pagerduty.com/v2/enqueue; the secret is the
#               integration's routing key.
SAFETY_ALERT_WEBHOOK=
SAFETY_ALERT_WEBHOOK_FORMAT=generic
SAFETY_ALERT_WEBHOOK_SECRET=

# Account email (required): verification and password-reset links. Any SMTP
# provider works (Amazon SES, SendGrid, Mailgun, Google Workspace, ...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=e-Tekisi <no-reply@tekisi.example.co.za>

# SMS codes (optional; phone verification and SMS reset are hidden without it).
#   bulksms    SMS_USERNAME / SMS_PASSWORD = API token id / secret
#   clickatell SMS_PASSWORD = API key
#   twilio     SMS_USERNAME = Account SID, SMS_PASSWORD = auth token, SMS_FROM = sender number
#   generic    SMS_URL gets POST {"to","message","from"}; SMS_PASSWORD, if set, as Authorization
SMS_PROVIDER=none
SMS_URL=
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM=

# Staff (operators/admins) must sign in with an authenticator-app code.
# The bootstrap operator is asked to set it up at the first sign-in.
STAFF_MFA_REQUIRED=true

# Version of the published terms / privacy policy / driver agreement. Change
# it whenever they change: everyone is asked to accept the new version.
LEGAL_VERSION=2026-10-20

# Monitoring. Prometheus scrapes the backend with METRICS_PASSWORD (16+
# chars: openssl rand -base64 24). Grafana is at http://localhost:3001 over an
# SSH tunnel; sign in as "admin" with GRAFANA_ADMIN_PASSWORD.
METRICS_PASSWORD=replace-with-openssl-rand-base64-24
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
# Where Alertmanager sends alerts (backend down, 5xx spike, unacknowledged
# safety alert, ...). Set at least one; they can be combined.
#   MONITORING_ALERT_WEBHOOK  Alertmanager-format webhook (Grafana OnCall,
#                             Opsgenie/Squadcast/incident.io integrations)
#   MONITORING_SLACK_WEBHOOK  Slack incoming webhook URL
#   MONITORING_PAGERDUTY_KEY  PagerDuty Events v2 integration key
MONITORING_ALERT_WEBHOOK=
MONITORING_SLACK_WEBHOOK=
MONITORING_PAGERDUTY_KEY=

# Backups (docs/BACKUP_RESTORE.md). Daily pg_dump at BACKUP_AT (TZ), kept
# locally for BACKUP_KEEP_DAYS.
TZ=Africa/Johannesburg
BACKUP_AT=02:00
BACKUP_KEEP_DAYS=14
# Strongly recommended: encrypt to an age public key (keep the private key
# OFF this server, e.g. in your password manager): age-keygen -o key.txt
BACKUP_AGE_RECIPIENT=
# Off-site copy (needs BACKUP_AGE_RECIPIENT). Any rclone destination, e.g.
#   :b2,account=KEY_ID,key=APP_KEY:tekisi-backups/db
#   :s3,provider=AWS,access_key_id=...,secret_access_key=...,region=af-south-1:bucket/db
BACKUP_RCLONE_REMOTE=
# Gets {"text": "..."} when a backup fails (Slack/Teams webhook works).
BACKUP_ALERT_WEBHOOK=

# Optional: where the frontend repo is, relative to this file.
# FRONTEND_DIR=../../e-tekisi-frontend-main/e-tekisi-frontend-main

# Optional: map tile provider for production traffic (OpenStreetMap's own
# tiles are for light use only).
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png?key=...
# MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# How long personal data is kept (days; 0 keeps it forever). Agree these with
# your Information Officer and state them in the privacy policy. GPS of trips
# with a CRITICAL safety alert is kept regardless, as evidence.
AUDIT_RETENTION_DAYS=90
RETENTION_TRIP_GPS_DAYS=90
RETENTION_DRIVER_LOCATION_DAYS=7
RETENTION_MESSAGES_DAYS=180
RETENTION_NOTIFICATIONS_DAYS=90
