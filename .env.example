# Local development database for docker-compose.yml.
# Copy to .env (which is gitignored). Use your own password: the backend
# reads DB_USERNAME / DB_PASSWORD, so export the same values when you run it
# (see README), or keep these values, which match the dev defaults.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=etekisi_db

# Optional: first operator account for the /ops screen (password 12+ chars).
# ADMIN_BOOTSTRAP_EMAIL=ops@example.test
# ADMIN_BOOTSTRAP_PASSWORD=
