# Tekisi production environment template.
# Copy to .env and fill in real values. NEVER commit .env.

DB_NAME=etekisi
DB_USER=etekisi_app
DB_PASSWORD=change-me-in-prod

# Min 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=https://tekisi.local
JWT_EXPIRY_MINUTES=60

# Comma-separated origins; no wildcards in prod.
CORS_ALLOWED_ORIGINS=https://app.tekisi.example,https://ops.tekisi.example

# Days of decision_audit history to retain.
AUDIT_RETENTION_DAYS=90

# First operator account, created on startup if it doesn't exist (optional).
# Password must be at least 12 characters.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
